import { HorizontalBox, VerticalBox, ListView, CheckBox } from "std-widgets.slint";
import { BusinessTabRow, InboxViewChoiceRow } from "../models.slint";
import { AppTheme } from "../design-system.slint";
import { TypeScale } from "../typography.slint";
import { Button } from "button.slint";
import { IconButton, LineEdit } from "controls.slint";
import { InboxViewChoice } from "inbox-view-choice.slint";
import { FormField } from "settings-components.slint";
import { ProfileColorChoice, ProfilePalette } from "profile-controls.slint";
import { RuntimeColorPicker } from "theme-editor.slint";

// Saved settings live in Rust. Every field below belongs to an isolated draft.
export global BusinessTabEditorUi {
    in property <bool> account-mode: false;
    in property <bool> visible: false;
    in property <string> editing-id;
    in-out property <string> name;
    in-out property <bool> show-name: true;
    in-out property <string> query;
    in property <image> icon;
    in property <bool> has-icon: false;
    in-out property <color> accent: #3b82f6;
    in-out property <bool> custom-accent: false;
    in property <string> error;
    in property <[InboxViewChoiceRow]> members;
    in property <int> selected-count;
    in property <bool> has-special-rules: false;
    in property <bool> recipient-only: false;
    callback open(string);
    callback open-account(string);
    callback choose-icon();
    callback remove-icon();
    callback search(string);
    callback toggle-member(string, bool);
    callback save() -> bool;
    callback cancel();
}

export global ReceivingInboxUi {
    in-out property <string> address;
    in-out property <string> source-emails;
    in property <string> error;
    in property <bool> created: false;
    callback create() -> bool;
}

export component BusinessTabEditor inherits VerticalBox {
    padding: 0px;
    spacing: 12px;
    init => { name-field.focus(); }
    Text {
        text: BusinessTabEditorUi.account-mode ? (BusinessTabEditorUi.editing-id == "" ? @tr("Create account") : @tr("Edit account")) : (BusinessTabEditorUi.editing-id == "" ? @tr("Create tab") : @tr("Edit tab"));
        color: AppTheme.heading;
        font-size: TypeScale.subtitle;
        font-weight: 600;
    }
    name-field := LineEdit {
        text <=> BusinessTabEditorUi.name;
        input-label: BusinessTabEditorUi.account-mode ? @tr("Account name") : @tr("Tab name");
        placeholder-text: BusinessTabEditorUi.account-mode ? @tr("Account name") : @tr("Tab name");
    }
    if !BusinessTabEditorUi.account-mode : CheckBox {
        text: @tr("Show name in the tab strip");
        checked <=> BusinessTabEditorUi.show-name;
        accessible-label: @tr("Show name in the tab strip");
    }
    HorizontalBox {
        padding: 0px;
        spacing: 8px;
        Rectangle {
            width: 44px; height: 44px;
            border-radius: 8px;
            background: AppTheme.muted-control-bg;
            if BusinessTabEditorUi.has-icon : Image {
                width: 36px; height: 36px;
                source: BusinessTabEditorUi.icon;
                image-fit: contain;
            }
            if !BusinessTabEditorUi.has-icon : Text {
                text: @tr("Icon"); color: AppTheme.secondary; font-size: TypeScale.caption;
            }
        }
        VerticalBox {
            padding: 0px;
            spacing: 6px;
            Button { text: @tr("Upload icon"); width: max(96px, self.content-width); clicked => { BusinessTabEditorUi.choose-icon(); } }
            Button { text: @tr("Remove icon"); width: max(96px, self.content-width); enabled: BusinessTabEditorUi.has-icon; clicked => { BusinessTabEditorUi.remove-icon(); } }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    Text {
        text: @tr("Color");
        color: AppTheme.secondary;
        font-size: TypeScale.caption;
        font-weight: 600;
    }
    HorizontalBox {
        padding: 0px;
        spacing: 8px;
        alignment: start;
        for swatch[index] in ProfilePalette.colors : ProfileColorChoice {
            width: 30px;
            height: 30px;
            value: swatch;
            selected: !BusinessTabEditorUi.custom-accent && BusinessTabEditorUi.accent == swatch;
            label: BusinessTabEditorUi.account-mode ? @tr("Account color {}", index + 1) : @tr("Profile color {}", index + 1);
            chosen => {
                BusinessTabEditorUi.custom-accent = false;
                BusinessTabEditorUi.accent = swatch;
            }
        }
    }
    Button {
        text: @tr("Custom color…");
        width: max(120px, self.content-width);
        selected: BusinessTabEditorUi.custom-accent;
        clicked => { BusinessTabEditorUi.custom-accent = true; }
    }
    if BusinessTabEditorUi.custom-accent : RuntimeColorPicker {
        height: 222px;
        value: BusinessTabEditorUi.accent;
        edited(value) => { BusinessTabEditorUi.accent = value; }
    }
    Text {
        text: BusinessTabEditorUi.account-mode ? @tr("Choose the email addresses and mailboxes that belong to this account. The same inbox can belong to more than one account.") : @tr("Choose the accounts to show in this business tab. An account can appear in more than one tab.");
        wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption;
    }
    if BusinessTabEditorUi.recipient-only : Text {
        text: @tr("Selected mailboxes control the sidebar. Existing recipient matching still searches every account. Address inboxes keep their own receiving-address and source filters.");
        wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption;
    }
    if BusinessTabEditorUi.has-special-rules && !BusinessTabEditorUi.recipient-only : Text {
        text: @tr("This tab also keeps its existing recipient and sender matching rules.");
        wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption;
    }
    LineEdit {
        text <=> BusinessTabEditorUi.query;
        input-label: BusinessTabEditorUi.account-mode ? @tr("Search mailboxes and addresses") : @tr("Search accounts");
        placeholder-text: BusinessTabEditorUi.account-mode ? @tr("Search mailboxes and addresses") : @tr("Search accounts");
        edited(value) => { BusinessTabEditorUi.search(value); }
    }
    Text {
        text: @tr("{} selected", BusinessTabEditorUi.selected-count);
        color: AppTheme.secondary; font-size: TypeScale.caption;
    }
    ListView {
        height: 208px;
        for account-choice in BusinessTabEditorUi.members : InboxViewChoice {
            choice: account-choice;
            toggled => { BusinessTabEditorUi.toggle-member(account-choice.key, !account-choice.checked); }
        }
    }
    if BusinessTabEditorUi.members.length == 0 : Text {
        text: @tr("No matches."); color: AppTheme.secondary;
        wrap: word-wrap; font-size: TypeScale.caption;
    }
    if BusinessTabEditorUi.error != "" : Text {
        text: BusinessTabEditorUi.error; color: AppTheme.destructive;
        wrap: word-wrap; font-size: TypeScale.caption;
        accessible-role: text;
    }
    HorizontalBox {
        padding: 0px;
        spacing: 8px;
        Rectangle { horizontal-stretch: 1; }
        Button { text: @tr("Cancel"); width: max(80px, self.content-width); clicked => { BusinessTabEditorUi.cancel(); } }
        Button { text: BusinessTabEditorUi.account-mode ? @tr("Save account") : @tr("Save tab"); width: max(90px, self.content-width); primary: true; enabled: BusinessTabEditorUi.name != ""; clicked => { BusinessTabEditorUi.save(); } }
    }
}

export component BusinessTabsCard inherits Rectangle {
    in property <[BusinessTabRow]> tabs;
    callback delete-tab(string);
    callback move-tab(string, int);
    background: AppTheme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: AppTheme.border;
    height: content.preferred-height;
    content := VerticalBox {
        padding: 16px;
        spacing: 12px;
        Text { text: @tr("Business tabs"); color: AppTheme.heading; font-size: TypeScale.subtitle; font-weight: 600; }
        Text { text: @tr("Group your accounts under a tab with its own name and icon."); color: AppTheme.secondary; font-size: TypeScale.caption; wrap: word-wrap; }
        if !BusinessTabEditorUi.visible || BusinessTabEditorUi.account-mode : VerticalBox {
            padding: 0px;
            spacing: 8px;
            for tab[index] in root.tabs : HorizontalBox {
                padding: 0px;
                spacing: 4px;
                height: 36px;
                if tab.has_logo : Image { width: 28px; height: 28px; source: tab.logo; image-fit: contain; }
                Rectangle { width: 10px; height: 10px; border-radius: 5px; background: tab.color; }
                Text { text: tab.name; color: AppTheme.body; font-size: TypeScale.body; overflow: elide; horizontal-stretch: 1; min-width: 0px; }
                IconButton { icon: @image-url("../icons/lucide/outline/pencil.svg"); icon-color: AppTheme.secondary; ghost: true; tooltip-text: @tr("Edit {}", tab.name); clicked => { BusinessTabEditorUi.open(tab.id); } }
                IconButton { icon: @image-url("../icons/lucide/outline/chevron-up.svg"); icon-color: AppTheme.secondary; ghost: true; tooltip-text: @tr("Move {} up", tab.name); interactive: index > 0; clicked => { root.move-tab(tab.id, -1); } }
                IconButton { icon: @image-url("../icons/lucide/outline/chevron-down.svg"); icon-color: AppTheme.secondary; ghost: true; tooltip-text: @tr("Move {} down", tab.name); interactive: index + 1 < root.tabs.length; clicked => { root.move-tab(tab.id, 1); } }
                IconButton { icon: @image-url("../icons/lucide/outline/trash.svg"); icon-color: AppTheme.destructive; ghost: true; tooltip-text: @tr("Delete {}", tab.name); clicked => { root.delete-tab(tab.id); } }
            }
            Button { text: @tr("Add tab"); width: max(96px, self.content-width); clicked => { BusinessTabEditorUi.open(""); } }
        }
        if BusinessTabEditorUi.visible && !BusinessTabEditorUi.account-mode : BusinessTabEditor { }
    }
}


export component ReceivingInboxCard inherits Rectangle {
    background: AppTheme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: AppTheme.border;
    height: form.preferred-height;
    form := VerticalBox {
        padding: 16px; spacing: 10px;
        Text { text: @tr("Add an address to the inbox list"); color: AppTheme.heading; font-size: TypeScale.subtitle; font-weight: 600; }
        Text { text: @tr("Create an inbox view for an address you receive mail at. This does not authorize sending from that address."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption; }
        FormField { label: @tr("Receiving address"); value <=> ReceivingInboxUi.address; placeholder: "team@example.com"; label-color: AppTheme.heading; }
        FormField { label: @tr("Source mailboxes (optional, comma-separated)"); value <=> ReceivingInboxUi.source-emails; placeholder: "mailbox@example.com"; label-color: AppTheme.heading; }
        Text { text: @tr("Leave sources empty to search all connected accounts. A source that is not connected stays selectable and will show no mail until it is connected."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption; }
        if ReceivingInboxUi.error != "" : Text { text: ReceivingInboxUi.error; wrap: word-wrap; color: AppTheme.destructive; font-size: TypeScale.caption; }
        if ReceivingInboxUi.created : Text { text: @tr("Address added. You can now select it in an account."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption; }
        Button { text: @tr("Add inbox view"); width: max(120px, self.content-width); enabled: ReceivingInboxUi.address != ""; clicked => { ReceivingInboxUi.create(); } }
    }
}

export global InboxAccountsUi {
    in property <[InboxViewChoiceRow]> accounts;
    in-out property <string> query;
    callback delete-account(string);
}

export component InboxAccountsCard inherits Rectangle {
    background: AppTheme.surface;
    border-radius: 10px; border-width: 1px; border-color: AppTheme.border;
    height: content.preferred-height;
    content := VerticalBox {
        padding: 16px; spacing: 12px;
        Text { text: @tr("Accounts"); color: AppTheme.heading; font-size: TypeScale.subtitle; font-weight: 600; }
        Text { text: @tr("Give each inbox a name and icon, then choose its email addresses or mailboxes. Add these accounts to your business tabs."); wrap: word-wrap; color: AppTheme.secondary; font-size: TypeScale.caption; }
        if !BusinessTabEditorUi.visible || !BusinessTabEditorUi.account-mode : VerticalBox {
            padding: 0px; spacing: 8px;
            ListView {
                height: min(304px, InboxAccountsUi.accounts.length * 54px);
                for account in InboxAccountsUi.accounts : Rectangle {
                    height: 54px;
                    HorizontalBox {
                        padding: 4px; spacing: 8px;
                        if account.has_avatar : Image { width: 30px; height: 30px; source: account.avatar; image-fit: contain; }
                        Rectangle { width: 10px; height: 10px; border-radius: 5px; background: account.color; }
                        VerticalBox {
                            padding: 0px; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
                            Text { text: account.name; color: AppTheme.heading; overflow: elide; font-size: TypeScale.body; }
                            Text { text: account.detail; color: AppTheme.secondary; overflow: elide; font-size: TypeScale.caption; }
                        }
                        IconButton { icon: @image-url("../icons/lucide/outline/pencil.svg"); icon-color: AppTheme.secondary; ghost: true; tooltip-text: @tr("Edit {}", account.name); clicked => { BusinessTabEditorUi.open-account(account.key); } }
                        IconButton { icon: @image-url("../icons/lucide/outline/trash.svg"); icon-color: AppTheme.destructive; ghost: true; tooltip-text: @tr("Remove {} from Accounts", account.name); clicked => { InboxAccountsUi.delete-account(account.key); } }
                    }
                }
            }
            Button { text: @tr("Add account"); width: max(110px, self.content-width); clicked => { BusinessTabEditorUi.open-account(""); } }
        }
        if BusinessTabEditorUi.visible && BusinessTabEditorUi.account-mode : BusinessTabEditor { }
    }
}
