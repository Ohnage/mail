import { TypeScale } from "../typography.slint";

// A label a message carries. The message list and the reading pane show the
// same chip; the list's denser rows take the compact size.
export component LabelChip inherits Rectangle {
    in property <string> name;
    in property <bool> name-has-emoji: false;
    // Gmail labels are tags; other accounts file labels like folders.
    in property <bool> use-label-icon: false;
    // 0 keeps the tag or folder glyph. 1 alert, 2 dollar, 3 check, 4 clock.
    in property <int> icon-kind: 0;
    in property <color> label-color;
    in property <color> text-color;
    in property <color> chip-border-color;
    in property <bool> compact: false;
    // The reading pane sets this so a hover control can take the label off.
    in property <bool> removable: false;
    callback remove();
    // The width that shows the whole name, and the least that still shows
    // its start. Removable chips keep room for the hover control.
    out property <length> natural-width: chip-name.x + chip-name.preferred-width + (root.removable ? 16px : 0px) + (root.compact ? 4px : 5px);
    out property <length> least-width: min(root.natural-width, chip-name.x + 2.5rem + (root.compact ? 4px : 5px));

    min-width: root.natural-width;
    preferred-width: root.natural-width;
    max-width: 180px;
    // Grows with the platform font instead of cutting the name off.
    height: root.compact ? max(20px, chip-name.preferred-height + 2px) : max(24px, chip-name.preferred-height + 4px);
    border-radius: root.compact ? 6px : 8px;
    border-width: 1px;
    border-color: root.chip-border-color;
    background: root.label-color.transparentize(0.88);

    Image {
        x: root.compact ? 5px : 7px;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        source: root.icon-kind == 1 ? @image-url("../icons/lucide/filled/alert.svg")
            : root.icon-kind == 2 ? @image-url("../icons/tag/dollar.svg")
            : root.icon-kind == 3 ? @image-url("../icons/lucide/outline/check.svg")
            : root.icon-kind == 4 ? @image-url("../icons/tag/clock.svg")
            : root.use-label-icon ? @image-url("../icons/lucide/filled/tag.svg")
            : @image-url("../icons/lucide/filled/file-directory.svg");
        colorize: root.label-color;
        image-fit: contain;
        accessible-role: none;
    }
    chip-name := Text {
        x: root.compact ? 21px : 23px;
        width: parent.width - self.x - (root.removable ? 16px : 4px);
        height: parent.height;
        text: root.name;
        color: root.text-color;
        font-size: TypeScale.caption;
        font-weight: 600;
        font-family: root.name-has-emoji ? "Noto Emoji" : "";
        overflow: elide;
        vertical-alignment: center;
    }

    chip-hit := TouchArea {
        width: parent.width;
        height: parent.height;
        enabled: root.removable;
        mouse-cursor: pointer;
    }

    if root.removable && chip-hit.has-hover : Rectangle {
        x: parent.width - 16px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: root.label-color;

        Image {
            x: 1px;
            y: 1px;
            width: 12px;
            height: 12px;
            source: @image-url("../icons/lucide/outline/x.svg");
            colorize: root.text-color;
            image-fit: contain;
            accessible-role: none;
        }

        TouchArea {
            clicked => { root.remove(); }
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: @tr("Remove label {}", root.name);
        }
    }
}
